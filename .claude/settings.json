{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/pdlc *)",
      "PowerShell(scripts/pdlc.cmd *)"
    ],
    "ask": [
      "Bash(scripts/pdlc approve *)",
      "Bash(scripts/pdlc reopen *)",
      "Bash(scripts/pdlc override *)",
      "Bash(scripts/pdlc track *)",
      "PowerShell(scripts/pdlc.cmd approve *)",
      "PowerShell(scripts/pdlc.cmd reopen *)",
      "PowerShell(scripts/pdlc.cmd override *)",
      "PowerShell(scripts/pdlc.cmd track *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"; fi"
          }
        ]
      }
    ]
  }
}
